{
  "name": "spitball",
  "displayName": "Spitball",
  "description": "Spitball: a living mind map of your local repo that grows with every commit, with an AI agent that pitches ideas while you code.",
  "version": "0.7.0",
  "publisher": "spitball",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/CashyO/ShellHacks.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/CashyO/ShellHacks/tree/main/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/CashyO/ShellHacks/issues"
  },
  "keywords": [
    "ai",
    "gemini",
    "git",
    "ideas",
    "mind map",
    "planning",
    "spitball"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onView:spitball.map"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spitball.open",
        "title": "Open Map",
        "category": "Spitball"
      },
      {
        "command": "spitball.showInSidebar",
        "title": "Show Map in Sidebar",
        "category": "Spitball"
      },
      {
        "command": "spitball.connectMap",
        "title": "Connect Existing Map",
        "category": "Spitball"
      },
      {
        "command": "spitball.mapRepository",
        "title": "Map This Repository",
        "category": "Spitball"
      },
      {
        "command": "spitball.suggestNow",
        "title": "Suggest Ideas From My Changes",
        "category": "Spitball"
      },
      {
        "command": "spitball.openInBrowser",
        "title": "Open Map in Browser",
        "category": "Spitball"
      }
    ],
    "configuration": {
      "title": "Spitball",
      "properties": {
        "spitball.url": {
          "type": "string",
          "default": "https://shellhacks-projectgraph-qrx89.ondigitalocean.app",
          "description": "Where the Spitball app is running. Defaults to the live site; use http://localhost:3000 when running the app yourself with npm run dev."
        },
        "spitball.passiveIdeas": {
          "type": "boolean",
          "default": true,
          "description": "Let the agent watch what you do (current file, function, errors, uncommitted changes) and pitch ideas via Gemini when you pause."
        },
        "spitball.ideaDelaySeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "How long to wait after you stop typing or save before asking for ideas."
        },
        "spitball.minIdeaIntervalSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 15,
          "description": "Minimum time between idea requests, to limit Gemini calls."
        },
        "spitball.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a new idea appears."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spitball",
          "title": "Spitball",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "spitball": [
        {
          "type": "webview",
          "id": "spitball.map",
          "name": "Mind Map"
        }
      ]
    }
  }
}
