GEMINI_API_KEY=
GEMINI_MODEL=            # current Flash model id from AI Studio
GEMINI_FALLBACK_MODEL=   # optional cheaper model used when the main one is overloaded
GITHUB_TOKEN=            # optional service token (rate limits / demo repo). Not needed once GitHub sign-in is set up
MONGODB_URI=
DEMO_REPO=               # owner/name of the demo repo that the "Try demo" button analyzes

# GitHub sign-in (OAuth App): github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=          # any random string, 32+ characters (encrypts the login cookie)
APP_URL=                 # optional: public URL, e.g. https://your-app.vercel.app (must match the OAuth callback host)

# !! LOCAL UI WORK ONLY. In Vercel / DigitalOcean this MUST be false, or every repo shows the sample demo map.
MOCK_MODE=true           # true = API routes use src/lib/mock.ts, no keys needed
AI_CACHE=on
